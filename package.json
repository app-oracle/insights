{
  "name": "app-oracle-sdk",
  "version": "0.1.0",
  "description": "SDK for generating feedback deep links via App Oracle",
  "keywords": [
    "app-oracle",
    "feedback",
    "deep-link",
    "sdk",
    "redis"
  ],
  "license": "MIT",
  "author": "Waylan Sands",
  "repository": {
    "type": "git",
    "url": "https://github.com/waylansands/app-oracle-sdk"
  },
  "bugs": {
    "url": "https://github.com/waylansands/app-oracle-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.0.1",
    "typescript": "^5.7.2",
    "vitest": "^1.2.0"
  }
}
